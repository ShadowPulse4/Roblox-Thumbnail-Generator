# ─────────────────────────────────────────────────────────────
# Nugget Studio AI — voorbeeldconfiguratie
# Kopieer dit bestand naar .env.local en vul je eigen waarden in.
# .env.local staat in .gitignore: zet NOOIT echte sleutels in Git.
# Geen enkele sleutel hier mag beginnen met NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# ── Afbeeldingen (verplicht om te kunnen genereren) ──────────
# Sleutel aanmaken: https://platform.openai.com/api-keys  (betaald per gebruik)
OPENAI_API_KEY=
# Welke dienst afbeeldingen maakt. Nu ondersteund: openai
IMAGE_PROVIDER=openai
# gpt-image-2 (aanrader), gpt-image-2.5-flare / gpt-image-2.5-sunburst (hebben ook "Ultra"),
# of oudere modellen zoals gpt-image-1.5 (die maken alleen vaste formaten; de app snijdt bij).
IMAGE_MODEL=gpt-image-2
# Hoe lang een generatie maximaal mag duren
IMAGE_TIMEOUT_SECONDS=240

# ── Prompt verbeteren met Claude (optioneel) ──────────────────
# Sleutel aanmaken: https://platform.claude.com  → API keys  (betaald per gebruik,
# los van een Claude Pro/Max-abonnement). Zonder sleutel werkt alles behalve "Prompt verbeteren".
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ── Toegang ───────────────────────────────────────────────────
# none  = geen login, één lokale gebruiker (alleen voor op je eigen computer)
# local = accounts met wachtwoord; jij maakt accounts aan voor vrienden
AUTH_MODE=none
# Alleen zetten als je bewust zonder login in productie draait (afgeraden)
ALLOW_OPEN_ACCESS=false
# In productie gaat de logincookie alleen over HTTPS. Bereiken vrienden de app via
# gewoon http in je thuisnetwerk (bijv. http://192.168.1.20:3000)? Zet dit dan op false.
COOKIE_SECURE=true

# ── Opslag ────────────────────────────────────────────────────
# Map voor de database (app.db) en alle afbeeldingen. Maak hier backups van.
DATA_DIR=./data

# ── Limieten (de server controleert ze, niet de browser) ──────
# Geschatte uitgaven voor de hele app. "off" = geen limiet.
DAILY_SPEND_LIMIT_USD=5
MONTHLY_SPEND_LIMIT_USD=30
# Afbeeldingen per lid per dag (beheerders hebben standaard geen daglimiet). Per account aan te passen in Instellingen.
DAILY_IMAGE_LIMIT_PER_USER=20
MAX_IMAGES_PER_REQUEST=4
RATE_LIMIT_PER_MINUTE=6
MAX_PROMPT_LENGTH=2000
